# Recommended: run scripts/setup_local.py to create .env and private SQL/TOML.
# Public template only. Never commit .env, runtime/ or real keys.
STUDENTBRIDGE_BACKEND=supabase
STUDENTBRIDGE_DEPLOYMENT=local
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Generate ONCE with setup_local.py; preserve across local/cloud deployments.
STUDENTBRIDGE_MASTER_KEY=
GROQ_API_KEY=
STUDENTBRIDGE_AI_PROVIDER=groq
PLANNER_MODEL=openai/gpt-oss-20b
REVIEWER_MODEL=openai/gpt-oss-120b
OLLAMA_PLANNER_MODEL=qwen3:4b
OLLAMA_REVIEWER_MODEL=gemma3:4b
STUDENTBRIDGE_DATA_DIR=runtime
STUDENTBRIDGE_FX_MODE=live
